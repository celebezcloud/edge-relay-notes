# ===== Hermes (custom provider AgentRouter) =====
HERMES_CUSTOM_AGENTROUTER_ORG_API_KEY=sk-xxx

# ===== Cloudflare (deploy worker via API) =====
# Global API Key — punya akses penuh (bukan scoped token Pages-only)
# Ambil di: Dashboard → My Profile → API Tokens → Global API Key
CF_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
CF_EMAIL=you@example.com
CF_API_KEY=cfk_xxx

# ===== Worker (opsional) =====
# Nama Worker yang kamu deploy sendiri + URL-nya setelah deploy
WORKER_NAME=my-relay
RELAY_BASE_URL=https://my-relay.YOUR_SUBDOMAIN.workers.dev/v1

# ===== Auth gate worker v5 (DIREKOMENDASIKAN) =====
# AgentRouter key yang diizinkan memakai relay ini. Kalau di-set, worker
# menolak semua request dengan Authorization berbeda (401 relay_auth_error)
# sebelum menyentuh upstream — URL yang bocor / repo yang di-copy jadi
# tidak berguna tanpa key ini. Kosongkan untuk relay terbuka (legacy).
RELAY_ALLOWED_KEY=sk-xxx
